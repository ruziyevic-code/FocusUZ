<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusUZ" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#101612</item>
        <item name="android:statusBarColor">#101612</item>
        <item name="android:navigationBarColor">#101612</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#91E8AC</item>
    </style>

    <style name="Theme.FocusUZ.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101612</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/focus_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.FocusUZ</item>
    </style>
</resources>
